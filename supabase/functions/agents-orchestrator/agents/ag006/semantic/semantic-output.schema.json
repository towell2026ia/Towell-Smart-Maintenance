{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "ag006_semantic_mapping",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "schema_version": {
        "type": "string",
        "enum": ["AG006-SEMANTIC-001"]
      },
      "mappings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source_reference": {
              "type": "object",
              "properties": {
                "sheet": { "type": "string" },
                "cell": { "type": "string" }
              },
              "required": ["sheet", "cell"],
              "additionalProperties": false
            },
            "proposed_field_type": {
              "type": "string",
              "enum": [
                "TEXT",
                "TEXTAREA",
                "INTEGER",
                "DECIMAL",
                "DATE",
                "DATETIME",
                "BOOLEAN",
                "YES_NO",
                "SELECT",
                "MULTISELECT",
                "CHECKBOX",
                "RADIO",
                "PHOTO",
                "FILE",
                "SIGNATURE",
                "MACHINE_SELECTOR",
                "TECHNICIAN_SELECTOR",
                "READ_ONLY"
              ]
            },
            "proposed_label": { "type": "string" },
            "proposed_options": {
              "type": "array",
              "items": { "type": "string" }
            },
            "confidence": { "type": "number" },
            "ambiguity_remaining": { "type": "boolean" },
            "requires_human_review": { "type": "boolean" },
            "reason_code": {
              "type": "string",
              "enum": [
                "BINARY_INSPECTION_STATE",
                "CLOSED_OPTION_LIST",
                "NUMERIC_MEASUREMENT",
                "FREE_TEXT_OBSERVATION",
                "CONTEXTUAL_INFORMATION",
                "EVIDENCE_FIELD",
                "DATE_FIELD",
                "DATETIME_FIELD",
                "AMBIGUOUS_SEMANTICS",
                "INSUFFICIENT_CONTEXT",
                "UNSUPPORTED_COMPONENT",
                "POSSIBLE_INSTRUCTION"
              ]
            }
          },
          "required": [
            "source_reference",
            "proposed_field_type",
            "proposed_label",
            "proposed_options",
            "confidence",
            "ambiguity_remaining",
            "requires_human_review",
            "reason_code"
          ],
          "additionalProperties": false
        }
      },
      "warnings": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "required": ["schema_version", "mappings", "warnings"],
    "additionalProperties": false
  }
}
