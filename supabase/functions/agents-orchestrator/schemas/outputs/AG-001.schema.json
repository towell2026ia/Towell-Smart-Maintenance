{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AG-001 Output Schema",
  "type": "object",
  "properties": {
    "event_code": { "type": "string" },
    "target_agent": {
      "type": "string",
      "enum": [
        "AG-001", "AG-002", "AG-003", "AG-004", "AG-005", "AG-006", "AG-007", "AG-008",
        "AG-009", "AG-009.1", "AG-009.2", "AG-009.3", "AG-010", "AG-011", "AG-012", "AG-013",
        "M-010", "M-011", "M-012", "M-013"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk_flags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "model_recommends_approval": { "type": "boolean" },
    "reason_code": {
      "type": "string",
      "enum": [
        "CORRECTIVE_FAILURE_REPORT",
        "RECURRENT_FAILURE",
        "COST_DEVIATION",
        "INSUFFICIENT_INFORMATION",
        "FORM_UPLOAD",
        "PREVENTIVE_PLANNING",
        "PREDICTIVE_PLANNING",
        "AUTONOMOUS_CHECKLIST",
        "AMBIGUOUS_UNCLASSIFIED",
        "INVALID_AGENT_TEST"
      ]
    }
  },
  "required": [
    "event_code",
    "target_agent",
    "confidence",
    "missing_fields",
    "risk_flags",
    "model_recommends_approval",
    "reason_code"
  ],
  "additionalProperties": false
}
