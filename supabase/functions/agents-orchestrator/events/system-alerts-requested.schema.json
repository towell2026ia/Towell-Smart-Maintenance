{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SystemAlertsRequestedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "origin"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": ["SYSTEM_ALERTS_REQUESTED"]
    },
    "origin": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": { "type": "string" },
        "screen": { "type": "string" },
        "status_filter": { "type": "string" },
        "severity_filter": { "type": "string" },
        "department": { "type": "string" }
      }
    }
  }
}
