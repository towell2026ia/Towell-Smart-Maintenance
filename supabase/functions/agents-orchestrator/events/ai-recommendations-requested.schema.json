{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIRecommendationsRequestedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "origin"
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": ["AI_RECOMMENDATIONS_REQUESTED"]
    },
    "origin": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": { "type": "string" },
        "screen": { "type": "string" },
        "machine_id": { "type": "string" },
        "folio": { "type": "string" },
        "department": { "type": "string" },
        "selected_tab": { "type": "string" },
        "calendar_id": { "type": "string" },
        "survey_id": { "type": "string" }
      }
    }
  }
}
